# Server port (LAN WebSocket + HTTP API + /api/webhook)
PORT=8787
HOST=0.0.0.0

# --- Mode 1: Ring Developer Playground (quick 30-min testing) ---
# Get token at https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=

# --- Mode 2: Production Private Use App (leave RING_ACCESS_TOKEN blank) ---
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=

# HMAC-SHA256 signing key from the Ring Developer Portal for /api/webhook verification
RING_HMAC_KEY=

# Optional: Bearer token accepted by /api/webhook and /api/test/trigger for local tests
RING_WEBHOOK_SECRET=

# Optional: default Ring device ID (ava1.ring.device.XXX). Auto-discovered if omitted.
RING_DEVICE_ID=

# Optional: shared secret required from the Shield Pro on /ws and /api/whep/*
RELAY_LAN_TOKEN=

# Optional: passcode required on /ring/link during one-way Private App account linking
# (defaults to RELAY_LAN_TOKEN if omitted)
LINK_PASSCODE=

# Optional: path to persist rotated OAuth refresh tokens on disk
TOKEN_STORE_PATH=./data/tokens.json
